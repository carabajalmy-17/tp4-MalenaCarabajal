<header class="cabecera-pagina">
    <div>
        <p class="etiqueta">Seccion Amiguitos</p>
        <h1><%= titulo %></h1>
    </div>
    <a class="boton" href="/mascotas/nuevo"> agregar mascota</a>
</header>
<%if (mascotas.length === 0) { %>
    <p>no hay mascotas</p>
<% } else {%>
    <section class="grilla" aria-label="Amiguitos disponibles">
        <% mascotas.forEach (mascota => {%>
            <article class="tarjeta">
                <img src="/img/mascota.svg" alt="" width="100" height="100">
                <h2><%= mascota.nombre %> </h2>
                <p> <span class="etiqueta"> Especie: </span><%= mascota.especie %></p>
                <p><span class="etiqueta">Edad:</span> <%= mascota.edad %></p>
                <p><span class="etiqueta">Estado</span> <%= mascota.estado %></p>

                <a href="/mascotas/<%= mascota.id %>">Ver detalle</a>
            </article>
        <% }) %>
    </section>
<% } %>
<a href="/"> volver </a>

