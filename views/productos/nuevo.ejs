<section class="panel-formulario">
    <p class="etiqueta">NUEVO INGRESO</p>
    <h1>
        <%= titulo %>
    </h1>
    <% if (error) { %>
        <p class="error" role="alert" class="formulario">
            <%= error %>
        </p>
        <% } %>
            <form action="/mascotas" method="post" class="formulario">
                <label for="nombre">Nombre</label>
                <input id="nombre" name="nombre" value="<%= valores.nombre ?? '' %>" required>

                <label for="especie">Especie:</label>
                <input id="especie" name="especie" value="<%= valores.especie ?? '' %>" required>

                <label for="edad">Edad</label>
                <input id="edad" name="edad" type="number" min="1" step="1" value="<%= valores.edad ?? '' %>" required>

                <label for="descripcion">Descripción</label>
                <textarea id="descripcion" name="descripcion" rows="5"
                    required><%= valores.descripcion ?? '' %> </textarea>

                <label for="estado">Estado</label>
                <select name="estado" id="estado" required>
                    <option id="Adoptado" name="Adoptado" value=<%=valores.estado ==="Adoptado"%> >Adoptado</option>
                    <option id="En adopcion" nombre="En adopcion" value=<%=valores.estado ==="En Adopcion"%>>En Adopcion</option>
                    <option id="reservado" nombre="reservado" value=<%=valores.estado ==="Reservado"%>>Reseervado</option>
                </select>

                <button type="submit">Guardar mascota</button>
            </form>
</section>